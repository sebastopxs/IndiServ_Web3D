<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bloquea tráfico HTTP en texto plano y rechaza certificados raíz instalados por usuario (anti-MitM) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Pinning SPKI SHA-256 sobre CA intermedias y raíz reales de Supabase y Vercel (sin fijar leaf de 90 días) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">pvrfnvrxaxulcxacdino.supabase.co</domain>
        <domain includeSubdomains="false">indiserv-web3d.vercel.app</domain>
        <pin-set expiration="2027-12-31">
            <!-- Google Trust Services WE1 (intermedia Supabase, exp 2029-02-20) -->
            <pin digest="SHA-256">kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4=</pin>
            <!-- Google Trust Services WR1 (intermedia Vercel, exp 2029-02-20) -->
            <pin digest="SHA-256">yDu9og255NN5GEf+Bwa9rTrqFQ0EydZ0r1FCh9TdAW4=</pin>
            <!-- GTS Root R4 (raíz Google Trust Services, exp 2028-01-28) -->
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
            <!-- GTS Root R1 (raíz Google Trust Services, exp 2028-01-28) -->
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
            <!-- GlobalSign Root CA (respaldo cross-signed, exp 2028-01-28) -->
            <pin digest="SHA-256">K87oWBWM9UZfyddvDfoxL+8lpNyoUB2ptGtn0fv6G2Q=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
