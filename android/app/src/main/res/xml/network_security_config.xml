<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bloquea tráfico HTTP en texto plano y rechaza certificados raíz instalados por usuario (anti-MitM) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
